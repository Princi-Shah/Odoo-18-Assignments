<odoo>
    <!--library book action-->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--library form view-->
    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">Form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="author_id"/>
                            <field name="library_id"/>
                            <field name="pages"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="date_release"/>
                            <field name="isbn_number"/>
                            <field name="book_state"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--library list view-->
    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">List</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="fetch_first_five_books_names"
                                type="object"
                                string="Fetch 1st Five Book Names"
                                class="oe_stat_button"
                    />
                    <button name="fetch_books_pages_more_than_300_using_orm"
                                type="object"
                                string="Book Pages More than 300"
                                class="oe_stat_button"
                    />
                </header>
                <field name="name"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="author_id"/>
                <field name="pages"/>
                <field name="member_id"/>
                <field name="library_id"/>
                <field name="book_state"/>
            </list>
        </field>
    </record>

    <!--library book search view-->
    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">Search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <filter string="No Authors" name="without_author" domain="[('author_id','=','False')]"/>
            </search>
        </field>
    </record>
</odoo>
