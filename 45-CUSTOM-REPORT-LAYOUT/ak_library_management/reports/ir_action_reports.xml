<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--custom layout with custom header and footer-->
    <record id="action_library_book_data_report" model="ir.actions.report">
        <field name="name">Custom Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.report_library_data</field>
        <field name="binding_model_id" ref="model_library_library"/>
    </record>

    <!--base inherited layout for header and footer with dynamic data-->
    <record id="action_library_book_data_internal_report" model="ir.actions.report">
        <field name="name">Custom Internal Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.report_data_internal</field>
        <field name="binding_model_id" ref="model_library_library"/>
    </record>
</odoo>