<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div" position="inside">
                <button name="action_view_reservations"
                        type="object"
                        class="oe_stat_button" icon="fa-book">
                    <field string="Reserve Book" name="reservation_book_count"
                               widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_reservation_wizard" type="object"
                        string="Reservation"/>
            </xpath>
        </field>
    </record>
</odoo>
