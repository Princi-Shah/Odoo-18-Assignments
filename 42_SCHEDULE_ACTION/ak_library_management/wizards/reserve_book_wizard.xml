<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reserve_book_wizard_form" model="ir.ui.view">
        <field name="name">reserve.book.wizard.form</field>
        <field name="model">reserve.book.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="customer_id" readonly="1"/>
                        <field name="book_id" readonly="1"/>
                        <field name="expected_pickup_date" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_pick_up"
                            string="Pick Up" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
