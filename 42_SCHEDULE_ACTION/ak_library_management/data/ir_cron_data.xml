<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="book_return_reminder" model="ir.cron">
            <field name="name">Book Return Reminder</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_book_reservation"/>
            <field name="code">model._cron_send_return_book_reminder_mail()</field>
            <field name="state">code</field>
            <field name="active" eval="True" />
            <field name="nextcall"
               eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
        </record>
    </data>
</odoo>
