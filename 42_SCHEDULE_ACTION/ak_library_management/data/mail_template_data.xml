<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_book_return_reminder" model="mail.template">
        <field name="name">Book Return Reminder Mail</field>
        <field name="model_id" ref="ak_library_management.model_book_reservation"/>
        <field name="email_from">{{'noreply@example.com'}}</field>
        <field name="email_to">{{object.customer_id.email_formatted or ''}}</field>
        <field name="subject">You have a Book Return date approaching Soon</field>
        <field name="description">
            Sent automatically to customers when Return date is
            approaching
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <strong t-out="object.customer_id.name or ''">user</strong>,
                    <br/>
                    <br/>
                    Please be advised that your Book
                    <strong t-out="object.book_id.name or ''"><br/>
                    has a return date approaching. You are pleased to return the book.
                    </strong>
                    <br/>
                    <br/>
                    Do not hesitate to contact us if you have any questions.
                    <br/>
                </p>
            </div>
        </field>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
