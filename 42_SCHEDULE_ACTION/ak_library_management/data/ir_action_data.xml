<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mark_book_as_returned" model="ir.actions.server">
        <field name="name">Mark Books as Returned</field>
        <field name="model_id"
               ref="ak_library_management.model_book_reservation"/>
        <field name="binding_model_id"
               ref="ak_library_management.model_book_reservation"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mark_books_as_returned()</field>
        <field name="groups_id"
               eval="[(4, ref('ak_library_management.group_library_admin')),
                      (4, ref('ak_library_management.group_library_assistant'))]"/>
    </record>
</odoo>
