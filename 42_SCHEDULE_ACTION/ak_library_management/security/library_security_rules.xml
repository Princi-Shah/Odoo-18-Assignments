<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="reservation_rule_admin_full_access" model="ir.rule">
            <field name="name">Library Admin</field>
            <field name="model_id" ref="model_book_reservation"/>
            <field name="groups"
                   eval="[(4, ref('ak_library_management.group_library_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="reservation_rule_assistant_reserved_only" model="ir.rule">
            <field name="name">Library Assistant</field>
            <field name="model_id" ref="model_book_reservation"/>
            <field name="groups"
                   eval="[(4, ref('ak_library_management.group_library_assistant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                [('state', 'not in', ('cancelled','picked up'))]</field>
        </record>
        
        <record id="reservation_rule_worker_view_only" model="ir.rule">
            <field name="name">Library Worker</field>
            <field name="model_id" ref="model_book_reservation"/>
            <field name="groups"
                   eval="[(4, ref('ak_library_management.group_library_worker'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('state', '=', 'reserved')]</field>
        </record>
    </data>
</odoo>
