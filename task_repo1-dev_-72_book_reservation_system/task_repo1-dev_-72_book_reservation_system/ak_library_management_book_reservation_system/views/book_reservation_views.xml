<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="book_reservation_action" model="ir.actions.act_window">
        <field name="name">Book Reservations</field>
        <field name="res_model">book.reservation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="book_reservation_list_view" model="ir.ui.view">
        <field name="name">book.reservation.list</field>
        <field name="model">book.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="book_id"/>
                <field name="reservation_date"/>
                <field name="expected_pickup_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="book_reservation_form_view" model="ir.ui.view">
        <field name="name">book.reservation.form</field>
        <field name="model">book.reservation</field>
        <field name="arch" type="xml">
            <form string="Book Reservation">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_reservation_button"
                            type="object" string="Reserve" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel_button"
                            type="object" string="Cancel" class="oe_highlight"
                            invisible="state in ['cancelled','draft']"/>
                    <button name="action_picked_up_button"
                            type="object" string="Pick Up" class="oe_highlight"
                            invisible="state in ['draft','cancelled','picked up']"/>
                </header>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="book_id"/>
                        <field name="reservation_date"/>
                        <field name="expected_pickup_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="book_reservation_search_view" model="ir.ui.view">
        <field name="name">book.reservation.search</field>
        <field name="model">book.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="book_id"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter string="Book" name="book"
                            context="{'group_by': 'book_id'}"/>
                    <filter string="Reservation Date" name="reservation date"
                            context="{'group_by': 'reservation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_export_reservations_server" model="ir.actions.server">
        <field name="name">Export Reservations</field>
        <field name="model_id"
               ref="ak_library_management_book_reservation_system.model_book_reservation"
        />
        <field name="binding_model_id"
               ref="ak_library_management_book_reservation_system.model_book_reservation"
        />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_export_reservations()</field>
    </record>

    <menuitem
            id="book_reservation_action_menu1"
            name="Reservation"
            parent="sale.product_menu_catalog"
            action="ak_library_management_book_reservation_system.book_reservation_action"
              />
</odoo>
