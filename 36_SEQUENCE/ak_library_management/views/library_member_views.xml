<odoo>
    <!-- Member Action -->
    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create your first member record.</p>
        </field>
    </record>

    <!-- Member Form View -->
    <record id="library_member_view_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="membership_no" readonly="1"/>
                            <field name="name"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="membership_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Member List View -->
    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="membership_no"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="membership_date"/>
            </list>
        </field>
    </record>
</odoo>
