<odoo>
    <!-- Library Action -->
    <record id="library_library_action" model="ir.actions.act_window">
        <field name="name">Libraries</field>
        <field name="res_model">library.library</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Library Form View -->
    <record id="library_library_view_form" model="ir.ui.view">
        <field name="name">library.library.form</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_book_borrow"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field name="borrowed_book_count" widget="statinfo"
                                   string="Borrowed"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="capacity"/>
                            <field name="notes"/>
                        </group>
                        <group>
                            <field name="book_count" readonly="1"/>
                            <field name="capacity_status" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list editable="bottom">
                                    <field name="book_reference"/>
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="isbn_number"/>
                                    <field name="date_release"/>
                                    <field name="book_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Library List View -->
    <record id="library_library_view_list" model="ir.ui.view">
        <field name="name">library.library.list</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="book_count"/>
                <field name="capacity_status"/>
            </list>
        </field>
    </record>
</odoo>
