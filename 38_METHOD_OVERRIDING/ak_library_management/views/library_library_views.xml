<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    library action-->
    <record id="library_library_action" model="ir.actions.act_window">
        <field name="name">Library</field>
        <field name="res_model">library.library</field>
        <field name="view_mode">list,form</field>
    </record>

<!--    library form view-->
    <record id="library_library_view_form" model="ir.ui.view">
        <field name="name">Library Form</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <field name="book_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}">
                        <list>
                            <field name="name"/>
<!--                            <field name="author_ids"/>-->
                            <field name="publisher"/>
                            <field name="edition"/>
<!--                            <field name="date_release"/>-->
                            <field name="pages"/>
                            <field name="available"/>
                            <field name="barcode" string="ISBN Number"/>
                        </list>
                    </field>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="capacity"/>
                        <field name="book_count" readonly="1"/>
                        <field name="capacity_status" readonly="1"/>
                        <field name="notes"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button type="action"
                                name="%(library_library_action)d"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field string="Borrowed Books" name="borrowed_book_count" widget="statinfo"/>
                        </button>
                    </div>
                    <notebook>
                        <page string="Books">
                            <field name="book_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="name"/>
<!--                                    <field name="author"/>-->
<!--                                    <field name="published_date"/>-->
                                    <field name="available"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

<!--    library list view-->
    <record id="library_library_view_list" model="ir.ui.view">
        <field name="name">Library List</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="book_count"/>
                <field name="capacity_status"/>
            </list>
        </field>
    </record>
</odoo>
