<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- library action -->
    <record id="library_library_action" model="ir.actions.act_window">
        <field name="name">Library</field>
        <field name="res_model">library.library</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--library form view-->
    <record id="library_library_view_form" model="ir.ui.view">
        <field name="name">Form</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                    </group>
                    <group>
                        <field name="book_ids">
                            <list>
                                <field name="name"/>
                                <field name="is_library_book"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--library list view-->
    <record id="library_library_view_list" model="ir.ui.view">
        <field name="name">List</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>
</odoo>
