<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_detail_template" name="Customer Details">
        <t t-call="website.layout">
            <div class="container fetchdata">
                <form>
                    <div class="form-group">
                        <label for="email">Email address:</label>
                        <input type="email" class="form-control" id="email11"/>
                    </div>
                    <br/><br/>
                    <div class="btn btn-primary" id="submitFetchData">Fetch Data</div>
                </form>
                <div id="resultdiv" name="result" class="mt-2">
                </div>
            </div>
        </t>
    </template>

    <record id="menu_contacts" model="website.menu">
        <field name="name">Customers</field>
        <field name="url">/customers</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
    </record>
</odoo>