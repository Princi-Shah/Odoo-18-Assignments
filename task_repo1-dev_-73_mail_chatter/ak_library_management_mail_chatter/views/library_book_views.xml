<odoo>
    <!--library list view-->
    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">List</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="borrower_member_id"/>
                <field name="library_id"/>
                <field name="library_location"/>
                <field name="book_reference"/>
            </list>
        </field>
    </record>

    <!--library form view-->
    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">Form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <field name="book_state" widget="statusbar"/>
                    <button name="action_mark_borrowed"
                            type="object" string="Mark as Borrowed"
                            invisible="book_state != 'available'"/>

                    <button name="action_return_book"
                            type="object" string="Return Book"
                            invisible="book_state == 'available'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="borrow_date"
                                   invisible="book_state == 'available'"/>
                            <field name="author_ids" widget="many2many_tags"/>
                            <field name="date_release"/>
                            <field name="library_id"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="library_location" readonly="1"/>
                            <field name="book_reference" readonly="1"/>
                            <field name="borrower_member_id"/>
                            <field name="due_date" readonly="1"
                                   invisible="book_state == 'available'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--library book action-->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--library book search view-->
    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">Search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_ids"/>
                <filter string="No Authors"
                        name="without_author"
                        domain="[('author_ids','=','False')]"/>
            </search>
        </field>
    </record>
</odoo>
