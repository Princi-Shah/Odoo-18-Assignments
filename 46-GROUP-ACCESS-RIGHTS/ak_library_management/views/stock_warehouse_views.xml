<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_view_form_inherit_form" model="ir.ui.view">
        <field name="name">stock.warehouse.view.form.inherit.form</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Library Staff">
                        <field name="library_assistant_id"
                               groups="ak_library_management.group_library_admin"/>
                        <field name="library_assistant_id"
                               groups="ak_library_management.group_library_assistant"
                               readonly="1"/>

                        <field name="worker_ids" widget="many2many_tags"
                               groups="ak_library_management.group_library_admin,ak_library_management_access_rights.group_library_assistant"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
